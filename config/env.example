### Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=risk_novelty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

### J-Quants (optional; required only if you use the J-Quants downloader notebooks)
# JPX_API_KEY=YOUR_JQUANTS_IDTOKEN_OR_API_KEY
# JQUANTS_USER=your@email
# JQUANTS_PASS=your_password

### Embedding model (sentence-transformers)
# Used in notebooks for novelty calculation
RISK_EMBED_MODEL=intfloat/multilingual-e5-small


